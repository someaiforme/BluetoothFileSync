<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#151C24" />
            <stroke android:width="1dp" android:color="#273442" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#24303D" />
            <stroke android:width="1dp" android:color="#3B4A5A" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1A232D" />
            <stroke android:width="1dp" android:color="#2D3A48" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
