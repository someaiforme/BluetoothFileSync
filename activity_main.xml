<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#090E14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="14dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:src="@drawable/bluetoothfilesync_logo"
                android:contentDescription="bluetoothfilesync logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bluetooth File Sync"
                    android:textColor="#F3F7FA"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Android/Windows file sync with Backups and Conflict handling"
                    android:textColor="#AAB7C4"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Activity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Activity"
                android:textColor="#F3F7FA"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="7dp" />

            <ScrollView
                android:id="@+id/activityScrollView"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:fillViewport="true"
                android:scrollbars="vertical"
                android:fadeScrollbars="false"
                android:background="#0D141C"
                android:padding="10dp">

                <TextView
                    android:id="@+id/statusView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="#C9D3DC"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:paddingBottom="4dp" />

            </ScrollView>
        </LinearLayout>

        <!-- Primary actions: keep the main controls directly under Activity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/syncButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:text="SYNC FILES"
                android:textColor="#07110B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:enabled="false"
                android:background="@drawable/primary_button" />

            <Button
                android:id="@+id/exitButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="EXIT"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/danger_button"
                android:visibility="visible" />
        </LinearLayout>

        <!-- Auto Sync: intentionally always visible -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_background"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto Sync"
                    android:textColor="#F3F7FA"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Automatically sync when the saved device and folder are available. Note: App will close on success"
                    android:textColor="#96A5B3"
                    android:textSize="12sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/autoSyncSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Enable automatic synchronization" />
        </LinearLayout>

        <!-- Device -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bluetooth Device"
                android:textColor="#F3F7FA"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/savedDeviceView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Device: None"
                android:textColor="#B9C5CF"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <Button
                android:id="@+id/scanButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CHANGE DEVICE"
                android:textColor="#DCE5EC"
                android:background="@drawable/secondary_button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Select Bluetooth Device"
                android:textColor="#F3F7FA"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ListView
                android:id="@+id/deviceList"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="7dp"
                android:background="#0D141C"
                android:divider="#222C36"
                android:dividerHeight="1dp"
                android:nestedScrollingEnabled="true"
                android:scrollbars="vertical"
                android:fadeScrollbars="false" />
        </LinearLayout>

        <!-- Sync Folder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sync Folder"
                android:textColor="#F3F7FA"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <TextView
                android:id="@+id/syncFolderView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sync folder:\n/storage/emulated/0/bluetoothfilesync"
                android:textColor="#B9C5CF"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:breakStrategy="simple" />

            <Button
                android:id="@+id/chooseFolderButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CHANGE FOLDER"
                android:textColor="#DCE5EC"
                android:background="@drawable/secondary_button" />
        </LinearLayout>

        <!-- Secondary actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/forgetDeviceButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="FORGET DEVICE"
                android:textColor="#DCE5EC"
                android:textSize="12sp"
                android:background="@drawable/secondary_button" />

            <Button
                android:id="@+id/historyButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="SYNC HISTORY"
                android:textColor="#DCE5EC"
                android:textSize="12sp"
                android:background="@drawable/secondary_button" />
        </LinearLayout>

        <!-- Conflicts/errors -->
        <TextView
            android:id="@+id/conflictView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_background"
            android:padding="12dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFD6D6"
            android:scrollbars="vertical" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
